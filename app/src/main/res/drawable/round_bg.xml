<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 背景色 -->
    <solid android:color="#F5F5F5" />

    <!-- 四边圆角半径 -->
    <corners android:radius="4dp" />

    <!-- 可选：添加边框 -->
    <!--
    <stroke
        android:width="1dp"
        android:color="#DDDDDD" />
    -->

    <!-- 可选：内边距设置，让内容不贴边 -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
